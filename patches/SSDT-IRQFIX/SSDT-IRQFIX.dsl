/*
 * SSDT-IRQFIX: the legacy IRQ fix (timer IRQ 0, RTC IRQ 8, PIC IRQ 2 removed) for macOS ONLY.
 *
 * It replaces three binary DSDT patches ("TIMR IRQ 0", "RTC IRQ 8", "IPIC IRQ 2") that applied to every OS
 * OpenCore boots, Windows included. Needs the three DSDT patches "TIMR/RTC/IPIC _CRS to XCRS". macOS gets exactly
 * the bytes the old patches produced (IRQNoFlags with an empty mask); every other OS gets the firmware _CRS.
 */
DefinitionBlock ("", "SSDT", 2, "YOGA", "IRQFIX", 0x00001000)
{
    External (_SB_.PCI0.LPCB.TIMR, DeviceObj)
    External (_SB_.PCI0.LPCB.TIMR.XCRS, BuffObj)
    External (_SB_.PCI0.LPCB.RTC_, DeviceObj)
    External (_SB_.PCI0.LPCB.RTC_.XCRS, BuffObj)
    External (_SB_.PCI0.LPCB.IPIC, DeviceObj)
    External (_SB_.PCI0.LPCB.IPIC.XCRS, BuffObj)

    Scope (\_SB.PCI0.LPCB.TIMR)
    {
        Name (BUFM, Buffer (21)
        {
                    0x47, 0x01, 0x40, 0x00, 0x40, 0x00, 0x01, 0x04, 0x47, 0x01, 0x50, 0x00, 0x50, 0x00, 0x10, 0x04,
                    0x22, 0x00, 0x00, 0x79, 0x00
        })
        Method (_CRS, 0, Serialized)  // _CRS: Current Resource Settings
        {
            If (_OSI ("Darwin"))
            {
                Return (BUFM)
            }
            Return (\_SB.PCI0.LPCB.TIMR.XCRS)
        }
    }

    Scope (\_SB.PCI0.LPCB.RTC_)
    {
        Name (BUFM, Buffer (13)
        {
                    0x47, 0x01, 0x70, 0x00, 0x70, 0x00, 0x01, 0x08, 0x22, 0x00, 0x00, 0x79, 0x00
        })
        Method (_CRS, 0, Serialized)  // _CRS: Current Resource Settings
        {
            If (_OSI ("Darwin"))
            {
                Return (BUFM)
            }
            Return (\_SB.PCI0.LPCB.RTC_.XCRS)
        }
    }

    Scope (\_SB.PCI0.LPCB.IPIC)
    {
        Name (BUFM, Buffer (141)
        {
                    0x47, 0x01, 0x20, 0x00, 0x20, 0x00, 0x01, 0x02, 0x47, 0x01, 0x24, 0x00, 0x24, 0x00, 0x01, 0x02,
                    0x47, 0x01, 0x28, 0x00, 0x28, 0x00, 0x01, 0x02, 0x47, 0x01, 0x2C, 0x00, 0x2C, 0x00, 0x01, 0x02,
                    0x47, 0x01, 0x30, 0x00, 0x30, 0x00, 0x01, 0x02, 0x47, 0x01, 0x34, 0x00, 0x34, 0x00, 0x01, 0x02,
                    0x47, 0x01, 0x38, 0x00, 0x38, 0x00, 0x01, 0x02, 0x47, 0x01, 0x3C, 0x00, 0x3C, 0x00, 0x01, 0x02,
                    0x47, 0x01, 0xA0, 0x00, 0xA0, 0x00, 0x01, 0x02, 0x47, 0x01, 0xA4, 0x00, 0xA4, 0x00, 0x01, 0x02,
                    0x47, 0x01, 0xA8, 0x00, 0xA8, 0x00, 0x01, 0x02, 0x47, 0x01, 0xAC, 0x00, 0xAC, 0x00, 0x01, 0x02,
                    0x47, 0x01, 0xB0, 0x00, 0xB0, 0x00, 0x01, 0x02, 0x47, 0x01, 0xB4, 0x00, 0xB4, 0x00, 0x01, 0x02,
                    0x47, 0x01, 0xB8, 0x00, 0xB8, 0x00, 0x01, 0x02, 0x47, 0x01, 0xBC, 0x00, 0xBC, 0x00, 0x01, 0x02,
                    0x47, 0x01, 0xD0, 0x04, 0xD0, 0x04, 0x01, 0x02, 0x22, 0x00, 0x00, 0x79, 0x00
        })
        Method (_CRS, 0, Serialized)  // _CRS: Current Resource Settings
        {
            If (_OSI ("Darwin"))
            {
                Return (BUFM)
            }
            Return (\_SB.PCI0.LPCB.IPIC.XCRS)
        }
    }
}
